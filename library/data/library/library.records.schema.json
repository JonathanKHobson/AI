{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGlossary Normalized Library Record",
  "type": "object",
  "required": [
    "entry_id",
    "collection",
    "source_slug",
    "title",
    "status",
    "aliases",
    "categories",
    "tags",
    "use_cases",
    "boosters",
    "fields",
    "related_entry_ids",
    "relationships",
    "provenance",
    "quality_flags",
    "search_text"
  ],
  "properties": {
    "entry_id": { "type": "string", "minLength": 1 },
    "collection": { "type": "string", "enum": ["glossary", "framework", "bias"] },
    "source_slug": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": ["string", "null"] },
    "status": { "type": "string", "minLength": 1 },
    "definition": { "type": "string" },
    "help": { "type": "string" },
    "notes": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw", "namespace", "value"],
        "properties": {
          "raw": { "type": "string" },
          "namespace": { "type": "string" },
          "value": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "use_cases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "boosters": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "key", "type", "description", "placeholder", "options"],
        "properties": {
          "label": { "type": "string" },
          "key": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "placeholder": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "related_entry_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target_entry_id", "reason", "metadata"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["same_subject", "related", "alias_of", "derived_from"]
          },
          "target_entry_id": { "type": "string" },
          "reason": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "object" },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "search_text": { "type": "string" }
  },
  "additionalProperties": false
}
